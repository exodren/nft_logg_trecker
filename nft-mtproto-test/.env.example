# Copy to .env and fill in. Never commit real values.

# Telegram bot (@BotFather)
BOT_TOKEN=

# MTProto (https://my.telegram.org). Log in once with: python test_gift.py
API_ID=
API_HASH=
# Session file used by the app; copied from sessions/mtproto_test.session on first start.
TELEGRAM_SESSION=sessions/app.session

# Kartoshka API token (see.tg mini app -> Полезное -> API). Empty = owner lookup disabled.
KARTOSHKA_API_TOKEN=

DATABASE_URL=sqlite+aiosqlite:///data/tracker.db
ADMIN_TELEGRAM_IDS=

LOG_LEVEL=INFO
MAX_CONCURRENT_API_REQUESTS=2
# 0 = free daily quota only (100 requests). Paid requests start only above 0.
DAILY_API_BUDGET_TON=0
# Seconds an owner lookup stays fresh.
API_CACHE_TTL=86400
# Seconds between listing scan cycles.
LISTING_SCAN_INTERVAL=300

# The only Telegram group that receives service logs (WARNING and above). Numeric group/supergroup id,
# e.g. -100…; the bot must be a member. Empty or invalid = no Telegram logs (logs/app.log still works).
LOG_GROUP_ID=

# Separate group for owner cards (listings that matched a user filter, owner with a public @username).
# The card has a "Занять лог" button: the first presser gets the owner in a private chat, the group message
# becomes "🔒 Лог занят". The bot must be an admin. Empty = off (cards go to users' private chats instead).
OWNER_LOG_GROUP_ID=
